<?xml version="1.0" encoding="UTF-8"?>
<!--
  Evolution X (branch cnb, Android 17) local manifest for onyx (POCO F7).
  Branch evolution-cnb of this repo, paired with the evolution-cnb branch of
  crdroid_onyx_patches. The A16 stack lives on in the evolution-bka branches
  of both, so keep the two in sync when a pin moves.

  Android 17 uses crDroid's published onyx 17.0 device/vendor
  branches where available. The onyx MIUI camera device helper remains on
  16.0-onyx because crDroid has not published a 17.0-onyx branch for that
  repository yet. cnb pins AOSP through the lineage-24.0 platform branch.

  The device tree stays crDroid's: crdroidandroid/android_device_xiaomi_onyx is
  a plain LineageOS tree (PRODUCT_NAME := lineage_onyx, and lineage_onyx.mk
  inherits vendor/lineage/config/common_full_phone.mk), and Evolution X mounts
  vendor_evolution at vendor/lineage and ships that very file, so it drops in
  unrenamed. Same for device/lineage/sepolicy (device_evolution_sepolicy, which
  carries libperfmgr) and hardware/lineage/interfaces, both of which
  BoardConfig.mk and device.mk include by path.

  Remotes are Evolution X's own: 'github' resolves to https://github.com/ and
  'gitlab' to https://gitlab.com, so nothing extra has to be declared here.

  Everything the device tree's crdroid.dependencies would fetch is pinned
  explicitly, so breakfast never needs roomservice to produce a complete tree.
-->
<manifest>

    <!-- ============================ device ============================ -->

    <project path="device/xiaomi/onyx"
             name="crdroidandroid/android_device_xiaomi_onyx"
             remote="github"
             revision="refs/heads/17.0" />

    <project path="hardware/xiaomi"
             name="crdroidandroid/android_hardware_xiaomi"
             remote="github"
             revision="refs/heads/17.0" />

    <!-- Matched Konoha prebuilt kernel, modules and device trees.
         No crDroid kernel/module/device-tree source repositories are synced. -->
    <project path="device/xiaomi/onyx-kernel"
             name="Loukious/konoha-android17-6.18"
             remote="github"
             revision="92dffd15e2099e2d57c70827a9e56a7f5d62f6a6"
             upstream="refs/heads/prebuilt-onyx"
             dest-branch="prebuilt-onyx"
             clone-depth="1" />

    <!-- ======================== vendor blobs ==========================
      All shallow: these are pure binary trees, nothing at build time reads
      their git history.
    -->

    <project path="vendor/xiaomi/onyx"
             name="crdroidandroid/proprietary_vendor_xiaomi_onyx"
             remote="gitlab"
             revision="refs/heads/17.0"
             clone-depth="1" />

    <!-- The ~350MB of OS3.0.302.0 radio/ images and the two LHDC-patched blobs
         that differ from the tree above. apply.sh copies these over it; forking
         the 4GB vendor repo is unnecessary. Hosted on GitLab, not GitHub, so
         the two images over 100MB can be stored whole via Git LFS (GitLab's
         free tier: 10GB storage, no bandwidth metering) instead of split into
         .partNN files. Needs the repo init git-lfs flag Evo already requires. -->
    <project path="vendor/xiaomi/onyx-firmware"
             name="Loukious/proprietary_vendor_xiaomi_onyx-firmware"
             remote="gitlab"
             revision="refs/heads/16.0"
             clone-depth="1" />

    <project path="vendor/xiaomi/onyx-lhdc"
             name="Loukious/android_vendor_xiaomi_onyx-lhdc"
             remote="gitlab"
             revision="refs/heads/16.0"
             clone-depth="1" />

    <!-- Fork carrying the modded 302 camera (fix33 lineage, commit 8754bab).
         Upstream crdroidandroid ships the stock 3.0.7 APK: do NOT repoint
         back, or the ROM loses every camera mod. -->
    <project path="vendor/xiaomi/onyx-miuicamera"
             name="Loukious/proprietary_vendor_xiaomi_miuicamera"
             remote="gitlab"
             revision="refs/heads/16.0-onyx"
             clone-depth="1" />

    <project path="device/xiaomi/onyx-miuicamera"
             name="crdroidandroid/android_device_xiaomi_miuicamera"
             remote="gitlab"
             revision="refs/heads/16.0-onyx"
             clone-depth="1" />

    <!-- ==================== device-tree hard deps =====================
      The current onyx device tree dropped the NotGameTurbo dependency in
      commit 80e10cb on 2026-10-17; the old app repo is now unavailable.
      LunarisDolby is still required (device.mk PRODUCT_PACKAGES), so retain
      its independent project below.

      crDroid's vendor/bcr is deliberately NOT here. Evo already ships bcr as a
      prebuilt in vendor/extras (wired by vendor/lineage/config/telephony.mk),
      and the two would define MODULE.TARGET.APPS.bcr twice. The device tree's
      inherit of vendor/bcr/bcr.mk is removed by patch
      device_xiaomi_onyx/0005-drop-crdroid-bcr.patch instead.
    -->

    <project path="packages/apps/LunarisDolby"
             name="crdroidandroid/android_packages_apps_LunarisDolby"
             remote="github"
             revision="refs/heads/16.0" />

    <!-- ========================= my own bits ==========================
      Auto-included by build/make/core/board_config.mk and
      vendor/lineage/config/common.mk purely by living at vendor/extra.
      Carries the unofficial build identity. The device kernel configuration must
      consume the matched Konoha prebuilts in device/xiaomi/onyx-kernel.
    -->

    <project path="vendor/extra"
             name="Loukious/android_vendor_extra"
             remote="github"
             revision="refs/heads/evolution-bka" />

    <!-- ===================== NOT listed, on purpose ====================
      GApps and the Pixel Launcher are Evolution X's own, so all five PixelOS
      projects that the crDroid manifest carried are gone:

        vendor/pixel/gms         -> Evo's vendor/gms (vendor_gms), inherited
                                    automatically by
                                    vendor/lineage/config/common_full_phone.mk
                                    because WITH_GMS defaults to true
        vendor/pixel/launcher    -> vendor_gms ships
                                    system_ext/packages/privileged_apps/
                                    NexusLauncherRelease
        vendor/pixel/sounds      -> vendor_gms ships SoundPickerPrebuilt
        vendor/pixel/clocks,
        vendor/pixel/themepicker -> covered by vendor/pixel-style's RRO set
                                    (WallpaperPicker2PixelOverlay,
                                    PixelSettingsGoogle, ...) plus
                                    vendor_gms' PixelWallpapers2025

      vendor/pixel-style also ships PixelLauncherNoGestureHintOverlay, the
      same overlay our old vendor_pixel_launcher patch added by hand and
      Evo's own GestureNavigationSettingsFragment already toggles it from the
      navigation_bar_hint preference. That patch and its privileged helper app
      are therefore dropped entirely.
    -->

</manifest>
